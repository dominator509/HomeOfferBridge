      "id": "if-consent",
      "name": "Has SMS Consent?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        1340,
        260
      ]
    },
    {
      "parameters": {
        "jsCode": "// Prefix Assembler (TOKENKILLER) — S0..PAD frozen, S3 volatile last.\nconst PREFIX = \"S0 You are the Instant Responder for a cash home-buyer. Reply within 60s. Never quote price. Never impersonate a human; disclose you are automated if asked. TCPA: include STOP. Concise reasoning.\\nS1 OUTPUT ONLY JSON: {\\\"sms_body\\\":\\\"<=320 chars, no links\\\",\\\"send\\\":bool,\\\"reason\\\":str}. If address invalid/spam set send=false reason=invalid_lead.\\nPAD ---- alignment pad, freeze after 64-token calc ----\";\nconst src = $input.first().json;\nconst v = { address: src.address, city: src.city, state: src.state, consent: src.consent === true };\nreturn [{ json: { body: {\n  model: $env.DEEPSEEK_MODEL,\n  temperature: 0,\n  max_tokens: 400,\n  messages: [\n    { role: 'system', content: PREFIX },\n    { role: 'user',   content: JSON.stringify(v) }\n  ]\n}, _prefix_bytes: PREFIX.length } }];"
      },
      "id": "assembler",
      "name": "Prefix Assembler (TOKENKILLER)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1560,
        200
      ],
      "notes": "PREFIX is a const literal → byte-identical every call → full-prefix cache hit."
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.DEEPSEEK_BASE }}/chat/completions",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.DEEPSEEK_API_KEY }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.body) }}",
        "options": {}
      },
      "id": "ds-http",
      "name": "DeepSeek · Flash-Thinking",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        1780,
        200
      ],
      "notes": "OpenAI-compatible. Prefix (system) cached on DeepSeek disk; only S3 user msg misses."
    },
    {
      "parameters": {
        "jsCode": "const r = $input.first().json;\nconst u = r.usage || {};\nconst hit = u.prompt_cache_hit_tokens || 0, miss = u.prompt_cache_miss_tokens || 0;\nconst ratio = (hit+miss) ? hit/(hit+miss) : 0;\nlet t = (r.choices && r.choices[0] && r.choices[0].message && r.choices[0].message.content) || '{}';\nlet out; try { out = JSON.parse(t.replace(/```json|```/g,'').trim()); } catch(e){ out = { _parse_error:true }; }\nout._cache = { hit, miss, ratio: +ratio.toFixed(4), ok: ratio >= 0.97 };\nif(!out._cache.ok) console.warn('TOKENKILLER: cache ratio below floor', out._cache);\nreturn [{ json: out }];"
      },
      "id": "ledger",
      "name": "Cache Ledger (NukeGuard)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2000,
        200
      ],
      "notes": "Reads DeepSeek usage; asserts >=0.97; append rows to cache_ledger; CI replay gate."
    },
    {
      "parameters": {
        "resource": "sms",
        "operation": "send",
        "from": "={{ $env.TWILIO_FROM }}",
        "to": "={{ $('Normalize + Validate').first().json.phone }}",
        "message": "={{ $json.sms_body }}"
      },
      "id": "twilio",
      "name": "Twilio · Send SMS",
      "type": "n8n-nodes-base.twilio",
      "typeVersion": 1,
      "position": [
        2220,
        200
      ],
      "notes": "Reached only when consent=true and agent set send=true."
    },
    {
      "parameters": {
        "url": "={{ $env.VALUATION_WEBHOOK }}",
        "method": "POST",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($('Normalize + Validate').first().json) }}",
        "options": {}
      },
      "id": "kick-val",
      "name": "→ Trigger Valuation (02)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        1340,
        400
      ]
    },
    {
