{
  "name": "04 \u00b7 Nurture Drip (DeepSeek, 12-24mo)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "nurture",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "wh",
      "name": "Nurture Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        240,
        300
      ],
      "webhookId": "nurture"
    },
    {
      "parameters": {
        "jsCode": "const j=$input.first().json;return [{json:{...j,drip_step:(j.drip_step||0)}}];"
      },
      "id": "step",
      "name": "Resolve Drip Step",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        460,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// Prefix Assembler (TOKENKILLER) \u2014 S0..PAD frozen, S3 volatile last.\nconst PREFIX = \"S0 You are the Nurture Copywriter. Value first, ask second. No pricing, no fake urgency. SMS<=320 + STOP; email needs address+unsubscribe. Vary wording each touch. Concise reasoning.\\nS1 Write the touch for drip_step. OUTPUT ONLY JSON: {channel:'sms'|'email',subject,body,cta,send_after_days}.\\nPAD ---- alignment pad ----\";\nconst src = $input.first().json;\nconst v = { city: src.city, situation: src.situation, drip_step: src.drip_step||0, channel_hint: src.channel_hint };\nreturn [{ json: { body: {\n  model: $env.DEEPSEEK_MODEL,\n  temperature: 0,\n  max_tokens: 500,\n  messages: [\n    { role: 'system', content: PREFIX },\n    { role: 'user',   content: JSON.stringify(v) }\n  ]\n}, _prefix_bytes: PREFIX.length } }];"
      },
      "id": "assembler",
      "name": "Prefix Assembler (TOKENKILLER)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        680,
        300
      ],
      "notes": "PREFIX is a const literal \u2192 byte-identical every call \u2192 full-prefix cache hit."
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.DEEPSEEK_BASE }}/chat/completions",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.DEEPSEEK_API_KEY }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.body) }}",
        "options": {}
      },
      "id": "ds-http",
      "name": "DeepSeek \u00b7 Flash-Thinking",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        900,
        300
      ],
      "notes": "OpenAI-compatible. Prefix (system) cached on DeepSeek disk; only S3 user msg misses."
    },
    {
      "parameters": {
        "jsCode": "const r = $input.first().json;\nconst u = r.usage || {};\nconst hit = u.prompt_cache_hit_tokens || 0, miss = u.prompt_cache_miss_tokens || 0;\nconst ratio = (hit+miss) ? hit/(hit+miss) : 0;\nlet t = (r.choices && r.choices[0] && r.choices[0].message && r.choices[0].message.content) || '{}';\nlet out; try { out = JSON.parse(t.replace(/```json|```/g,'').trim()); } catch(e){ out = { _parse_error:true }; }\nout._cache = { hit, miss, ratio: +ratio.toFixed(4), ok: ratio >= 0.97 };\nif(!out._cache.ok) console.warn('TOKENKILLER: cache ratio below floor', out._cache);\nreturn [{ json: out }];"
      },
      "id": "ledger",
      "name": "Cache Ledger (NukeGuard)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1120,
        300
      ],
      "notes": "Reads DeepSeek usage; asserts >=0.97; append rows to cache_ledger; CI replay gate."
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.channel }}",
              "value2": "sms"
            }
          ]
        }
      },
      "id": "if-ch",
      "name": "SMS or Email?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        1340,
        300
      ]
    },
    {
      "parameters": {
        "resource": "sms",
        "operation": "send",
        "from": "={{ $env.TWILIO_FROM }}",
        "to": "={{ $('Nurture Webhook').first().json.phone }}",
        "message": "={{ $json.body }}"
      },
      "id": "sms",
      "name": "Send SMS",
      "type": "n8n-nodes-base.twilio",
      "typeVersion": 1,
      "position": [
        1560,
        220
      ]
    },
    {
      "parameters": {
        "fromEmail": "hello@{{ $env.DOMAIN }}",
        "toEmail": "={{ $('Nurture Webhook').first().json.email }}",
        "subject": "={{ $json.subject }}",
        "text": "={{ $json.body }}"
      },
      "id": "email",
      "name": "Send Email",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2,
      "position": [
        1560,
        380
      ]
    },
    {
      "parameters": {
        "amount": 1,
        "unit": "days"
      },
      "id": "wait",
      "name": "Wait to Next Touch",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1,
      "position": [
        1780,
        300
      ],
      "notes": "Set from $json.send_after_days; re-enters to advance drip_step."
    }
  ],
