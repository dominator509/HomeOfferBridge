{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Property",
  "type": "object",
  "required": [
    "property_id",
    "address",
    "city",
    "state"
  ],
  "properties": {
    "property_id": {
      "type": "string"
    },
    "address": {
      "type": "string"
    },
    "city": {
      "type": "string"
    },
    "state": {
      "type": "string"
    },
    "zip": {
      "type": [
        "string",
        "null"
      ]
    },
    "beds": {
      "type": [
        "number",
        "null"
      ]
    },
    "baths": {
      "type": [
        "number",
        "null"
      ]
    },
    "sqft": {
      "type": [
        "number",
        "null"
      ]
    },
    "lot_sqft": {
      "type": [
        "number",
        "null"
      ]
    },
    "year_built": {
      "type": [
        "number",
        "null"
      ]
    },
    "occupancy": {
      "enum": [
        "owner",
        "tenant",
        "vacant",
        "unknown"
      ]
    },
    "condition_notes": {
      "type": [
        "string",
        "null"
      ]
    },
    "hazard_flags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "flood, foundation, roof_age, etc."
    },
    "avm_estimate": {
      "type": [
        "number",
        "null"
      ]
    },
    "comps": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "inspection": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "inspected_at": {
          "type": "string"
        },
        "inspector": {
          "type": "string"
        },
        "repair_estimate": {
          "type": "number"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "self_rated_condition": {
      "enum": [
        "excellent",
        "good",
        "fair",
        "poor",
        "severe",
        null
      ]
    },
    "disclosed_issues": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}